+// Copyright (c) 2026 UCLA Networked & Embedded Systems Laboratory
+// SPDX-License-Identifier: BSD-3-Clause
+// 4-bit activation support for CREST's quantization study; not part of TensorFlow Lite Micro. See crest_act4.h.
+#include "tensorflow/lite/micro/kernels/crest_act4.h"
+
+#include <cstring>
+
+namespace crest_act4 {
+namespace {
+
+#ifdef CREST_ACT4_CONTAINER_DEFAULT
+bool g_packed = false;
+#else
+bool g_packed = true;
+#endif
+
+// Word access without alignment assumptions: Cortex-M4/M7 and x86 allow unaligned 32-bit loads and stores, and
+// the aligned(1) type keeps the compiler from merging them into instructions that do not.
+typedef uint32_t __attribute__((may_alias, aligned(1))) Word;
+
+// Sign-extends four 4-bit values held in the low nibbles of four bytes. Each byte's bit 3 is copied into bits 4-7
+// with one multiply (the four shifted copies never overlap, so nothing carries between bytes).
+inline uint32_t SignExtendNibbles(uint32_t nibbles) { return nibbles | ((nibbles & 0x08080808u) * 0x1Eu); }
+
+inline void Locate(int total, int index, int* byte, int* high) {
+  const int full = total & ~7;
+  if (index < full) {
+    *byte = ((index >> 3) << 2) | (index & 3);
+    *high = (index >> 2) & 1;
+  } else {
+    const int k = index - full;
+    *byte = (full >> 1) + (k >> 1);
+    *high = k & 1;
+  }
+}
+
+// Number of whole 8-value groups that start at `start` (a multiple of 8), fit in `count`, and are full groups.
+inline int WholeGroups(int total, int start, int count) {
+  const int full = total & ~7;
+  if (start >= full) return 0;
+  return MinInt(count >> 3, (full - start) >> 3);
+}
+
+template <bool kShifted>
+void UnpackImpl(const int8_t* packed, int total, int start, int count, int8_t* out) {
+  int i = 0;
+  for (; i < count && ((start + i) & 7) != 0; ++i) {
+    out[i] = static_cast<int8_t>(GetValue(packed, total, start + i) + (kShifted ? 8 : 0));
+  }
+  const int groups = i < count ? WholeGroups(total, start + i, count - i) : 0;
+  const Word* in = reinterpret_cast<const Word*>(packed + ((start + i) >> 1));
+  Word* destination = reinterpret_cast<Word*>(out + i);
+  for (int g = 0; g < groups; ++g) {
+    const uint32_t word = in[g];
+    if (kShifted) {
+      // A 4-bit two's complement nibble n holds q; q + 8 is n with bit 3 flipped.
+      destination[2 * g] = (word & 0x0F0F0F0Fu) ^ 0x08080808u;
+      destination[2 * g + 1] = ((word >> 4) & 0x0F0F0F0Fu) ^ 0x08080808u;
+    } else {
+      destination[2 * g] = SignExtendNibbles(word & 0x0F0F0F0Fu);
+      destination[2 * g + 1] = SignExtendNibbles((word >> 4) & 0x0F0F0F0Fu);
+    }
+  }
+  i += groups * 8;
+  for (; i < count; ++i) {
+    out[i] = static_cast<int8_t>(GetValue(packed, total, start + i) + (kShifted ? 8 : 0));
+  }
+}
+
+}  // namespace
+
+bool PackedActivations() { return g_packed; }
+
+void SetPackedActivations(bool packed) { g_packed = packed; }
+
+int8_t GetValue(const int8_t* packed, int total, int index) {
+  int byte, high;
+  Locate(total, index, &byte, &high);
+  const int8_t value = packed[byte];
+  return high ? static_cast<int8_t>(value >> 4) : static_cast<int8_t>(static_cast<int8_t>(value << 4) >> 4);
+}
+
+void SetValue(int8_t* packed, int total, int index, int8_t value) {
+  int byte, high;
+  Locate(total, index, &byte, &high);
+  uint8_t* target = reinterpret_cast<uint8_t*>(packed) + byte;
+  const uint8_t nibble = static_cast<uint8_t>(value) & 0x0F;
+  *target = high ? static_cast<uint8_t>((*target & 0x0F) | (nibble << 4))
+                 : static_cast<uint8_t>((*target & 0xF0) | nibble);
+}
+
+void Unpack(const int8_t* packed, int total, int start, int count, int8_t* out) {
+  UnpackImpl<false>(packed, total, start, count, out);
+}
+
+void UnpackShifted(const int8_t* packed, int total, int start, int count, int8_t* out) {
+  UnpackImpl<true>(packed, total, start, count, out);
+}
+
+void Pack(const int8_t* values, int total, int start, int count, int8_t* packed) {
+  int i = 0;
+  for (; i < count && ((start + i) & 7) != 0; ++i) SetValue(packed, total, start + i, values[i]);
+  const int groups = i < count ? WholeGroups(total, start + i, count - i) : 0;
+  const Word* source = reinterpret_cast<const Word*>(values + i);
+  Word* out = reinterpret_cast<Word*>(packed + ((start + i) >> 1));
+  for (int g = 0; g < groups; ++g) {
+    out[g] = (source[2 * g] & 0x0F0F0F0Fu) | ((source[2 * g + 1] & 0x0F0F0F0Fu) << 4);
+  }
+  i += groups * 8;
+  for (; i < count; ++i) SetValue(packed, total, start + i, values[i]);
+}
+
+const int8_t* GatherTile(const Tile& tile, int line, const int8_t* data, int total, bool packed, bool shifted,
+                         int8_t* buffer) {
+  if (!packed) {
+    if (tile.in_step == 1) return data + tile.in_first * line;
+    for (int t = 0; t < tile.in_lines; ++t) {
+      memcpy(buffer + t * line, data + (tile.in_first + t * tile.in_step) * line, line);
+    }
+    return buffer;
+  }
+  if (tile.in_step == 1) {
+    (shifted ? UnpackShifted : Unpack)(data, total, tile.in_first * line, tile.in_lines * line, buffer);
+    return buffer;
+  }
+  for (int t = 0; t < tile.in_lines; ++t) {
+    (shifted ? UnpackShifted : Unpack)(data, total, (tile.in_first + t * tile.in_step) * line, line,
+                                       buffer + t * line);
+  }
+  return buffer;
+}
+
+int8_t* TileOutput(const Tile& tile, int line, int8_t* data, bool packed, int8_t* buffer) {
+  if (!packed && tile.out_step == 1) return data + tile.out_first * line;
+  return buffer;
+}
+
+void ScatterTile(const Tile& tile, int line, int8_t* data, int total, bool packed, const int8_t* buffer) {
+  if (!packed && tile.out_step == 1) return;
+  if (tile.out_step == 1) {
+    Pack(buffer, total, tile.out_first * line, tile.out_lines * line, data);
+    return;
+  }
+  for (int t = 0; t < tile.out_lines; ++t) {
+    const int destination = (tile.out_first + t * tile.out_step) * line;
+    if (packed) {
+      Pack(buffer + t * line, total, destination, line, data);
+    } else {
+      memcpy(data + destination, buffer + t * line, line);
+    }
+  }
+}
+
+}  // namespace crest_act4
