+// Collects output values in a small buffer and packs them in order.
+class PackedWriter {
+ public:
+  PackedWriter(int8_t* output, int total) : output_(output), total_(total) {}
+  void Fill(int8_t value, int count) {
+    while (count > 0) {
+      const int n = count < kCapacity - fill_ ? count : kCapacity - fill_;
+      for (int i = 0; i < n; ++i) buffer_[fill_ + i] = value;
+      fill_ += n;
+      count -= n;
+      if (fill_ == kCapacity) Flush();
+    }
+  }
+  void Copy(const int8_t* input, int input_total, int start, int count) {
+    while (count > 0) {
+      const int n = count < kCapacity - fill_ ? count : kCapacity - fill_;
+      crest_act4::Unpack(input, input_total, start, n, buffer_ + fill_);
+      fill_ += n;
+      start += n;
+      count -= n;
+      if (fill_ == kCapacity) Flush();
+    }
+  }
+  void Flush() {
+    if (fill_ == 0) return;
+    crest_act4::Pack(buffer_, total_, written_, fill_, output_);
+    written_ += fill_;
+    fill_ = 0;
+  }
+
+ private:
+  static constexpr int kCapacity = 64;
+  int8_t buffer_[kCapacity];
+  int8_t* output_;
+  int total_;
+  int written_ = 0;
+  int fill_ = 0;
+};
+
+// Pads a packed 4-bit tensor with its zero point. Dimensions are aligned to the right in a 5-D index space, and
+// each innermost run is copied whole.
+TfLiteStatus EvalPackedInt4Pad(TfLiteContext* context, const OpData* data, const TfLiteEvalTensor* input,
+                               TfLiteEvalTensor* output) {
+  const int dims = input->dims->size;
+  TF_LITE_ENSURE(context, dims >= 1 && dims <= 5);
+  int in_shape[5];
+  int out_shape[5];
+  int left[5];
+  for (int i = 0; i < 5; ++i) {
+    const int index = i - (5 - dims);
+    in_shape[i] = index < 0 ? 1 : input->dims->data[index];
+    out_shape[i] = index < 0 ? 1 : output->dims->data[index];
+    left[i] = index < 0 ? 0 : data->params.left_padding[index];
+  }
+  const int8_t* input_data = tflite::micro::GetTensorData<int8_t>(input);
+  const int input_total = static_cast<int>(ElementCount(*input->dims));
+  PackedWriter writer(tflite::micro::GetTensorData<int8_t>(output), static_cast<int>(ElementCount(*output->dims)));
+  const int8_t pad_value = static_cast<int8_t>(data->output_zero_point);
+  for (int o0 = 0; o0 < out_shape[0]; ++o0) {
+    const int i0 = o0 - left[0];
+    for (int o1 = 0; o1 < out_shape[1]; ++o1) {
+      const int i1 = o1 - left[1];
+      for (int o2 = 0; o2 < out_shape[2]; ++o2) {
+        const int i2 = o2 - left[2];
+        for (int o3 = 0; o3 < out_shape[3]; ++o3) {
+          const int i3 = o3 - left[3];
+          const bool inside = i0 >= 0 && i0 < in_shape[0] && i1 >= 0 && i1 < in_shape[1] && i2 >= 0 &&
+                              i2 < in_shape[2] && i3 >= 0 && i3 < in_shape[3];
+          if (!inside) {
+            writer.Fill(pad_value, out_shape[4]);
+            continue;
+          }
+          const int base = (((i0 * in_shape[1] + i1) * in_shape[2] + i2) * in_shape[3] + i3) * in_shape[4];
+          writer.Fill(pad_value, left[4]);
+          writer.Copy(input_data, input_total, base, in_shape[4]);
+          writer.Fill(pad_value, out_shape[4] - left[4] - in_shape[4]);
+        }
+      }
+    }
+  }
+  writer.Flush();
+  return kTfLiteOk;
+}
