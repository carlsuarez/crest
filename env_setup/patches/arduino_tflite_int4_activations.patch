@@ -0,0 +1,42 @@
+// Copyright (c) 2026 UCLA Networked & Embedded Systems Laboratory
+// SPDX-License-Identifier: BSD-3-Clause
+// 4-bit activation support for CREST's quantization study; not part of TensorFlow Lite Micro.
+//
+// Activation tensors with type kTfLiteInt4 hold values in [-8, 7] with their own scale and zero point.
+// In packed mode (the default) they are stored two values per byte and the memory planner reserves half a byte
+// per element. Convolution kernels unpack a tile of input rows into a small scratch buffer, run the unchanged
+// CMSIS-NN int8 kernel on it, and pack the output rows back, so the arithmetic is exactly the int8 kernel's.
+// In container mode the same tensors are stored one value per byte; it exists to check packed mode bit for bit.
+//
+// Packed layout. Activation bytes never leave the runtime, so the layout is chosen for cheap unpacking:
+// - "planar8", used when a tensor row (W * C elements) is a multiple of 8: elements 8g..8g+3 sit in the low
+//   nibbles of bytes 4g..4g+3 and elements 8g+4..8g+7 in their high nibbles, so one 32-bit word unpacks to two
+//   words with a few masks;
+// - "pairwise" otherwise (TFLite's INT4 weight layout): element 2i in the low nibble of byte i, 2i+1 in the high.
+#ifndef TENSORFLOW_LITE_MICRO_KERNELS_CREST_ACT4_H_
+#define TENSORFLOW_LITE_MICRO_KERNELS_CREST_ACT4_H_
+
+#include <cstdint>
+
+namespace crest_act4 {
+
+bool PackedActivations();
+void SetPackedActivations(bool packed);
+
+// Layout of a packed tensor whose rows hold `row_elements` values.
+inline bool PlanarLayout(int row_elements) { return (row_elements % 8) == 0; }
+
+// Unpacks `count` values starting at element `start` into sign-extended int8 values.
+// With the planar layout, `start` and `count` must be multiples of 8 (whole rows always are).
+void Unpack(const int8_t* packed, int start, int count, int8_t* out, bool planar);
+
+// Like Unpack, but returns q + 8 (in [0, 15]) instead of q: for a tensor with zero point -8 that is q minus its
+// zero point, so a kernel can take it with an input offset of 0. It is also cheaper (no sign extension).
+void UnpackShifted(const int8_t* packed, int start, int count, int8_t* out, bool planar);
+
+// Packs `count` int8 values (each already in [-8, 7]) starting at element `start`. Same rules as Unpack.
+void Pack(const int8_t* values, int start, int count, int8_t* packed, bool planar);
+
+}  // namespace crest_act4
+
+#endif  // TENSORFLOW_LITE_MICRO_KERNELS_CREST_ACT4_H_
