+  input_dims.w = input_shape.Dims(2);
+  input_dims.c = depth;
+  cmsis_nn_dims output_dims;
+  output_dims.n = 1;
+  output_dims.h = output_shape.Dims(1);
+  output_dims.w = output_shape.Dims(2);
