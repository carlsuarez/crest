+// Copyright (c) 2026 UCLA Networked & Embedded Systems Laboratory
+// SPDX-License-Identifier: BSD-3-Clause
+// 4-bit activation support for CREST's quantization study; not part of TensorFlow Lite Micro.
+//
+// Activation tensors with type kTfLiteInt4 hold values in [-8, 7] with their own scale and zero point.
+// In packed mode (the default) they are stored two values per byte and the memory planner reserves half a byte
+// per element. Kernels unpack a tile of their input into a small scratch buffer, run the unchanged int8 kernel on
+// it, and pack the output back, so the arithmetic is exactly the int8 kernel's.
+// In container mode the same tensors are stored one value per byte; it exists to check packed mode bit for bit.
+//
+// Packed layout. Activation bytes never leave the runtime, so the layout is chosen for cheap unpacking, and it
+// depends only on an element's flat index, so a reshape is a byte copy. For a tensor of N values, each full group
+// of 8 values (elements 8g..8g+7) takes bytes 4g..4g+3: elements 8g..8g+3 in the low nibbles and 8g+4..8g+7 in
+// the high nibbles, so one 32-bit word unpacks to two words with a few masks. The last N % 8 values follow
+// two per byte, the even one in the low nibble.
+#ifndef TENSORFLOW_LITE_MICRO_KERNELS_CREST_ACT4_H_
+#define TENSORFLOW_LITE_MICRO_KERNELS_CREST_ACT4_H_
+
+#include <cstdint>
+
+namespace crest_act4 {
+
+bool PackedActivations();
+void SetPackedActivations(bool packed);
+
+// Bytes a packed tensor of `total` values occupies.
+inline int PackedBytes(int total) { return (total + 1) / 2; }
+
+// One value of a packed tensor of `total` values.
+int8_t GetValue(const int8_t* packed, int total, int index);
+void SetValue(int8_t* packed, int total, int index, int8_t value);
+
+// Copies values [start, start + count) of a packed tensor of `total` values into int8 `out`.
+void Unpack(const int8_t* packed, int total, int start, int count, int8_t* out);
+
+// Like Unpack, but returns q + 8 (in [0, 15]) instead of q: for a tensor with zero point -8 that is q minus its
+// zero point, so a kernel can take it with an input offset of 0. It is also cheaper (no sign extension).
+void UnpackShifted(const int8_t* packed, int total, int start, int count, int8_t* out);
+
+// Stores int8 values (each already in [-8, 7]) as values [start, start + count) of a packed tensor.
+void Pack(const int8_t* values, int total, int start, int count, int8_t* packed);
+
+// ---------------------------------------------------------------------------------------------------------------
+// Tiling along one spatial axis, shared by convolution, depthwise convolution, and pooling.
+//
+// A "line" is one step along the tiled axis: a row (W * C values) when tiling along height, or one column (C
+// values) when the tensor has height 1 and tiling goes along width. A tile is a run of output lines plus the
+// input lines they read. Kernels gather a tile's input lines into scratch, call the int8 kernel on the tile, and
+// write the output lines back.
+//
+// With a packed input and dilation d > 1 at stride 1, tiles follow the dilation's phases: output lines o with
+// (o - pad) % d == r read only input lines congruent to r, so gathering every d-th line turns the tile into a
+// dense convolution with dilation 1. Otherwise one output line's receptive field spans (kernel - 1) * d + 1
+// input lines, and a TCN layer with d = 64 would unpack nearly its whole input.
+
+struct Axis {
+  int in_lines;
+  int out_lines;
+  int kernel;
+  int stride;
+  int dilation;
+  int pad;  // padding before the first input line
+};
+
+struct Tile {
+  int in_first;   // input line of tile line 0
+  int in_step;    // input lines between consecutive tile lines
+  int in_lines;   // input lines in the tile
+  int tile_pad;   // padding lines before the tile, as the int8 kernel must see it
+  int out_first;  // output line of tile output line 0
+  int out_step;   // output lines between consecutive tile output lines
+  int out_lines;  // output lines in the tile
+  int stride;     // stride the int8 kernel sees along the axis
+  int dilation;   // dilation the int8 kernel sees along the axis
+};
+
+inline int MinInt(int a, int b) { return a < b ? a : b; }
+inline int MaxInt(int a, int b) { return a > b ? a : b; }
+
+// Calls f(tile) for every tile of up to `chunk` output lines. Returns false when a tile would read no input line,
+// which a valid convolution or pooling never needs.
+template <typename F>
+bool ForEachTile(const Axis& a, int chunk, bool phased, F&& f) {
+  if (chunk < 1) chunk = 1;
+  if (!(phased && a.stride == 1 && a.dilation > 1)) {
+    for (int o0 = 0; o0 < a.out_lines; o0 += chunk) {
+      const int o1 = MinInt(o0 + chunk, a.out_lines);
+      const int top = o0 * a.stride - a.pad;
+      const int bottom = (o1 - 1) * a.stride - a.pad + (a.kernel - 1) * a.dilation;
+      const int first = MaxInt(top, 0);
+      const int last = MinInt(bottom, a.in_lines - 1);
+      if (last < first) return false;
+      const Tile tile = {first, 1, last - first + 1, first - top, o0, 1, o1 - o0, a.stride, a.dilation};
+      f(tile);
+    }
+    return true;
+  }
+  const int d = a.dilation;
+  for (int r = 0; r < d; ++r) {
+    const int o_first = ((r + a.pad) % d + d) % d;
+    if (o_first >= a.out_lines) continue;
+    const int count = (a.out_lines - 1 - o_first) / d + 1;
+    const int j0 = (o_first - a.pad - r) / d;  // exact: o_first - pad - r is a multiple of d
+    const int i_max = r <= a.in_lines - 1 ? (a.in_lines - 1 - r) / d : -1;
+    for (int m0 = 0; m0 < count; m0 += chunk) {
+      const int m1 = MinInt(m0 + chunk, count);
+      const int top = j0 + m0;
+      const int bottom = j0 + m1 - 1 + a.kernel - 1;
+      const int first = MaxInt(top, 0);
+      const int last = MinInt(bottom, i_max);
+      if (last < first) return false;
+      const Tile tile = {r + first * d, d, last - first + 1, first - top, o_first + m0 * d, d, m1 - m0, 1, 1};
+      f(tile);
+    }
+  }
+  return true;
+}
+
+// Puts a tile's input lines (each `line` values) where the int8 kernel can read them: the tensor itself for a
+// contiguous int8 tile, otherwise `buffer`. A packed input is unpacked, shifted by 8 when `shifted`.
+const int8_t* GatherTile(const Tile& tile, int line, const int8_t* data, int total, bool packed, bool shifted,
+                         int8_t* buffer);
+
+// Where the int8 kernel should write a tile's output lines, and how to put them back afterwards.
+int8_t* TileOutput(const Tile& tile, int line, int8_t* data, bool packed, int8_t* buffer);
+void ScatterTile(const Tile& tile, int line, int8_t* data, int total, bool packed, const int8_t* buffer);
+
+// Whether a tile's output goes through `buffer` (so the kernel needs an output scratch buffer).
+inline bool TileNeedsOutputBuffer(bool packed_output, bool phased_tiles) { return packed_output || phased_tiles; }
+
+// Which axis an NHWC operator is tiled along, and its line sizes. Tensors with height 1 (1-D models such as TCNs,
+// whose Conv1D layers become CONV_2D over a 1 x T image) are tiled along width; everything else along height.
+struct SpatialPlan {
+  bool along_width;
+  Axis axis;
+  int in_line;   // values per input line
+  int out_line;  // values per output line
+  int chunk;     // output lines per tile
+};
+
+inline SpatialPlan MakeSpatialPlan(int in_h, int in_w, int in_c, int out_h, int out_w, int out_c, int kernel_h,
+                                   int kernel_w, int stride_h, int stride_w, int dilation_h, int dilation_w,
+                                   int pad_h, int pad_w, int rows_per_tile, int columns_per_tile) {
+  SpatialPlan plan;
+  plan.along_width = in_h == 1 && out_h == 1;
+  if (plan.along_width) {
+    const Axis axis = {in_w, out_w, kernel_w, stride_w, dilation_w, pad_w};
+    plan.axis = axis;
+    plan.in_line = in_c;
+    plan.out_line = out_c;
+    plan.chunk = columns_per_tile;
+  } else {
+    const Axis axis = {in_h, out_h, kernel_h, stride_h, dilation_h, pad_h};
+    plan.axis = axis;
+    plan.in_line = in_w * in_c;
+    plan.out_line = out_w * out_c;
+    plan.chunk = rows_per_tile;
+  }
+  return plan;
+}
+
+// Writes a tile's extent, padding and stride along the plan's axis into CMSIS-NN dims and parameters.
+template <typename Dims, typename Params>
+inline void ApplyTileAxis(const SpatialPlan& plan, const Tile& tile, Dims* in_dims, Dims* out_dims, Params* params) {
+  if (plan.along_width) {
+    in_dims->w = tile.in_lines;
+    out_dims->w = tile.out_lines;
+    params->padding.w = tile.tile_pad;
+    params->stride.w = tile.stride;
+  } else {
+    in_dims->h = tile.in_lines;
+    out_dims->h = tile.out_lines;
+    params->padding.h = tile.tile_pad;
+    params->stride.h = tile.stride;
+  }
+}
+
+// The same for convolution parameters, which also carry a dilation.
+template <typename Dims, typename Params>
+inline void ApplyConvTile(const SpatialPlan& plan, const Tile& tile, Dims* in_dims, Dims* out_dims, Params* params) {
+  ApplyTileAxis(plan, tile, in_dims, out_dims, params);
+  if (plan.along_width) {
+    params->dilation.w = tile.dilation;
+  } else {
+    params->dilation.h = tile.dilation;
+  }
+}
