+// Input rows needed for one output row of a convolution with dilation 1, clipped to the input.
+inline void A4RowRange(int out_y, int stride_h, int pad_top, int kernel_h, int input_h, int* first_row,
+                       int* rows, int* tile_pad) {
+  const int top = out_y * stride_h - pad_top;
+  const int first = top < 0 ? 0 : top;
+  const int last = (top + kernel_h - 1) < (input_h - 1) ? (top + kernel_h - 1) : (input_h - 1);
+  *first_row = first;
+  *rows = last - first + 1;
+  *tile_pad = first - top;
+}
