+                       int* first_row, int* rows, int* tile_pad) {
+  const int top = out_y * stride_h - pad_top;
+  const int bottom = (out_y + out_rows - 1) * stride_h - pad_top + kernel_h - 1;
+  const int first = top < 0 ? 0 : top;
