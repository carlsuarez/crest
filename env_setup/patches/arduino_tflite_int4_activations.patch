+    *data->a4_plan = crest_act4::MakeSpatialPlan(
+        input->dims->data[1], input->dims->data[2], depth, output->dims->data[1], output->dims->data[2], depth,
+        params->filter_height, params->filter_width, params->stride_height, params->stride_width, 1, 1,
+        data->reference_op_data.padding.height, data->reference_op_data.padding.width, kA4PoolRows,
+        kA4PoolColumns);
+    const crest_act4::SpatialPlan& plan = *data->a4_plan;
