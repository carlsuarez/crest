+// Copyright (c) 2026 UCLA Networked & Embedded Systems Laboratory
+// SPDX-License-Identifier: BSD-3-Clause
+// 4-bit activation support for CREST's quantization study; not part of TensorFlow Lite Micro. See crest_act4.h.
+#include "tensorflow/lite/micro/kernels/crest_act4.h"
+
+namespace crest_act4 {
+namespace {
+
+#ifdef CREST_ACT4_CONTAINER_DEFAULT
+bool g_packed = false;
+#else
+bool g_packed = true;
+#endif
+
+// Planar rows always start on a 4-byte boundary of a 16-byte aligned arena buffer.
+typedef uint32_t __attribute__((may_alias)) Word;
+
+inline int8_t Low(uint8_t byte) { return static_cast<int8_t>(static_cast<int8_t>(byte << 4) >> 4); }
+inline int8_t High(uint8_t byte) { return static_cast<int8_t>(static_cast<int8_t>(byte) >> 4); }
+
+// Sign-extends four 4-bit values held in the low nibbles of four bytes. Each byte's bit 3 is copied into bits 4-7
+// with one multiply (the four shifted copies never overlap, so nothing carries between bytes).
+inline uint32_t SignExtendNibbles(uint32_t nibbles) { return nibbles | ((nibbles & 0x08080808u) * 0x1Eu); }
+
+void UnpackPairwise(const int8_t* packed, int start, int count, int8_t* out) {
+  const uint8_t* in = reinterpret_cast<const uint8_t*>(packed) + (start >> 1);
+  int index = 0;
+  if ((start & 1) != 0 && count > 0) {
+    out[index++] = High(*in++);
+  }
+  for (; index + 1 < count; index += 2) {
+    const uint8_t byte = *in++;
+    out[index] = Low(byte);
+    out[index + 1] = High(byte);
+  }
+  if (index < count) {
+    out[index] = Low(*in);
+  }
+}
+
+void PackPairwise(const int8_t* values, int start, int count, int8_t* packed) {
+  uint8_t* out = reinterpret_cast<uint8_t*>(packed) + (start >> 1);
+  int index = 0;
+  if ((start & 1) != 0 && count > 0) {
+    *out = static_cast<uint8_t>((*out & 0x0F) | (static_cast<uint8_t>(values[index++]) << 4));
+    ++out;
+  }
+  for (; index + 1 < count; index += 2) {
+    *out++ = static_cast<uint8_t>((static_cast<uint8_t>(values[index]) & 0x0F) |
+                                  (static_cast<uint8_t>(values[index + 1]) << 4));
+  }
+  if (index < count) {
+    *out = static_cast<uint8_t>((*out & 0xF0) | (static_cast<uint8_t>(values[index]) & 0x0F));
+  }
+}
+
+}  // namespace
+
+bool PackedActivations() { return g_packed; }
+
+void SetPackedActivations(bool packed) { g_packed = packed; }
+
+void Unpack(const int8_t* packed, int start, int count, int8_t* out, bool planar) {
+  if (!planar) {
+    UnpackPairwise(packed, start, count, out);
+    return;
+  }
+  const Word* in = reinterpret_cast<const Word*>(packed + (start >> 1));
+  Word* destination = reinterpret_cast<Word*>(out);
+  for (int group = count >> 3; group > 0; --group) {
+    const uint32_t word = *in++;
+    destination[0] = SignExtendNibbles(word & 0x0F0F0F0Fu);
+    destination[1] = SignExtendNibbles((word >> 4) & 0x0F0F0F0Fu);
+    destination += 2;
+  }
+}
+
+void UnpackShifted(const int8_t* packed, int start, int count, int8_t* out, bool planar) {
+  if (!planar) {
+    UnpackPairwise(packed, start, count, out);
+    for (int index = 0; index < count; ++index) out[index] = static_cast<int8_t>(out[index] + 8);
+    return;
+  }
+  const Word* in = reinterpret_cast<const Word*>(packed + (start >> 1));
+  Word* destination = reinterpret_cast<Word*>(out);
+  for (int group = count >> 3; group > 0; --group) {
+    const uint32_t word = *in++;
+    // A 4-bit two's complement nibble n holds q; q + 8 is n with bit 3 flipped.
+    destination[0] = (word & 0x0F0F0F0Fu) ^ 0x08080808u;
+    destination[1] = ((word >> 4) & 0x0F0F0F0Fu) ^ 0x08080808u;
+    destination += 2;
+  }
+}
+
+void Pack(const int8_t* values, int start, int count, int8_t* packed, bool planar) {
+  if (!planar) {
+    PackPairwise(values, start, count, packed);
+    return;
+  }
+  const Word* source = reinterpret_cast<const Word*>(values);
+  Word* out = reinterpret_cast<Word*>(packed + (start >> 1));
+  for (int group = count >> 3; group > 0; --group) {
+    *out++ = (source[0] & 0x0F0F0F0Fu) | ((source[1] & 0x0F0F0F0Fu) << 4);
+    source += 2;
+  }
+}
+
+}  // namespace crest_act4
