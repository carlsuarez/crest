+// Packed 4-bit operands: unpack 64 values of each input at a time, call the int8 kernel, and pack the result.
+// Inputs and output may each be int8 or packed 4-bit; shapes must match (no broadcasting).
+TfLiteStatus EvalPackedInt4Add(TfLiteContext* context, const tflite::ArithmeticParams& op_params,
+                               const OpData* data, const TfLiteEvalTensor* input1,
+                               const TfLiteEvalTensor* input2, TfLiteEvalTensor* output) {
+  TF_LITE_ENSURE(context, !data->requires_broadcast);
+  const int total = static_cast<int>(ElementCount(*output->dims));
+  TF_LITE_ENSURE_EQ(context, static_cast<int>(ElementCount(*input1->dims)), total);
+  TF_LITE_ENSURE_EQ(context, static_cast<int>(ElementCount(*input2->dims)), total);
+  const bool a4_input1 = input1->type == kTfLiteInt4;
+  const bool a4_input2 = input2->type == kTfLiteInt4;
+  const bool a4_output = output->type == kTfLiteInt4;
+  const int8_t* data1 = tflite::micro::GetTensorData<int8_t>(input1);
+  const int8_t* data2 = tflite::micro::GetTensorData<int8_t>(input2);
+  int8_t* out = tflite::micro::GetTensorData<int8_t>(output);
+  int8_t a[64];
+  int8_t b[64];
+  int8_t c[64];
+  for (int start = 0; start < total; start += 64) {
+    const int n = total - start < 64 ? total - start : 64;
+    const int8_t* x = data1 + start;
+    const int8_t* y = data2 + start;
+    if (a4_input1) {
+      crest_act4::Unpack(data1, total, start, n, a);
+      x = a;
+    }
+    if (a4_input2) {
+      crest_act4::Unpack(data2, total, start, n, b);
+      y = b;
+    }
+    int8_t* z = a4_output ? c : out + start;
+    arm_elementwise_add_s8(x, y, op_params.input1_offset, op_params.input1_multiplier, op_params.input1_shift,
+                           op_params.input2_offset, op_params.input2_multiplier, op_params.input2_shift,
+                           op_params.left_shift, z, op_params.output_offset, op_params.output_multiplier,
+                           op_params.output_shift, op_params.quantized_activation_min,
+                           op_params.quantized_activation_max, n);
+    if (a4_output) crest_act4::Pack(c, total, start, n, out);
+  }
+  return kTfLiteOk;
+}
