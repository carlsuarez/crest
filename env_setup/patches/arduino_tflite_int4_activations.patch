--- a/src/tensorflow/lite/micro/kernels/crest_act4.cpp	1969-12-31 16:00:00.000000000 -0800
+++ b/src/tensorflow/lite/micro/kernels/crest_act4.cpp	2026-11-15 17:28:35.516561463 -0800
